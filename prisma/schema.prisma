generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  createdAt     DateTime       @default(now())
  sessions      Session[]
  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
}

model Admin {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             String // 'super' | 'admin'
  permissions      String // JSON array string
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  sessions         Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id             String   @id
  name           String
  brand          String
  category       String
  gender         String
  price          Float
  originalPrice  Float?
  rating         Float
  reviews        Int
  isNew          Boolean  @default(false)
  stock          Int
  description    String
  colorwaySole   String
  colorwayUpper  String
  colorwayAccent String
  colors         String // JSON array string
  sizes          String // JSON array string
  images         String? // JSON array string of photo URLs
  // JSON array: [{ color, hex, images: [url], stock: { "<size>": qty } }].
  // `colors`, `images` and `stock` above are kept in sync from this on save.
  variants       String   @default("[]")
  saleId         String?
  sale           Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  ratingEntries  Review[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Sale {
  id         String    @id @default(cuid())
  name       String
  percentage Int
  enabled    Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  products   Product[]
  banners    Banner[]
}

model Order {
  id                String      @id @default(cuid())
  orderId           String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  total             Float
  deliveryFee       Float       @default(0)
  status            String      @default("Pending") // Pending | Confirmed | Delivered
  estimatedDelivery String
  shippingAddress   String? // JSON object string
  paymentMethod     String?
  createdAt         DateTime    @default(now())
  items             OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  brand     String
  price     Float
  size      Int
  qty       Int
  colorway  String // JSON object string
  colorName String?
  imageUrl  String?
}

model Banner {
  id          String  @id @default(cuid())
  eyebrow     String
  headingLine1 String
  headingLine2 String
  description String
  sole        String
  upper       String
  accent      String
  imageUrl    String?
  sortOrder   Int     @default(0)
  saleId      String?
  sale        Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
}

model Settings {
  id               Int     @id @default(1)
  codEnabled       Boolean @default(true)
  codLabel         String  @default("Cash on Delivery")
  jazzcashEnabled  Boolean @default(true)
  jazzcashLabel    String  @default("JazzCash")
  easypaisaEnabled Boolean @default(true)
  easypaisaLabel   String  @default("EasyPaisa")
  cardEnabled      Boolean @default(true)
  cardLabel        String  @default("Card")
  whatsappEnabled  Boolean @default(true)
  whatsappNumber   String  @default("923001234567")
  brandStripEnabled Boolean @default(true)

  deliveryFee          Int     @default(200)
  freeDeliveryAbove    Int     @default(0) // 0 = no free-delivery threshold
  deliveryTime         String  @default("3–5 working days")
  deliveryCities       String  @default("[]") // JSON: [{ city, fee, time }]

  storePhone           String  @default("")
  storeEmail           String  @default("")
  storeAddress         String  @default("Main Bazaar, Mandi Sadiq Ganj")
  storeHours           String  @default("")
  storeMapUrl          String  @default("")

  returnDays           Int     @default(7)
  returnSaleItems      Boolean @default(false)
  returnPolicy         String  @default("")

  originalBadgeEnabled Boolean @default(false)
  categories           String  @default("[]") // JSON array of category names
}

model CartItem {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  productId String
  name      String
  brand     String
  price     Float
  size      Int
  qty       Int
  colorway  String // JSON object string
  colorName String?
  imageUrl  String?

  @@unique([userId, key])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String

  @@unique([userId, productId])
}
